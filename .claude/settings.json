{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/specs/approved/**)",
      "Bash(python tools/approve_spec.py:*)",
      "Bash(uv run python tools/approve_spec.py:*)",
      "Bash(make approve:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --amend:*)",
      "Edit(/mod/generated/**)",
      "Edit(/generated/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)"
    ],
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run python tools/check_provenance.py)",
      "Bash(uv run python compiler/compile.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)"
    ]
  }
}
